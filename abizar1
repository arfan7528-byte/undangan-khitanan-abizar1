/* =================================
   TOMBOL BUKA UNDANGAN + MUSIK
================================= */

const openButton =
  document.getElementById("openButton");

const cover =
  document.getElementById("cover");

const content =
  document.getElementById("content");

const musik =
  document.getElementById("musik");

const musicButton =
  document.getElementById("musicButton");


openButton.addEventListener("click", function () {

  cover.style.display = "none";

  content.classList.remove("hidden");

  musik.play()
    .catch(function(error) {
      console.log("Musik belum dapat dimainkan:", error);
    });

  window.scrollTo({
    top: 0,
    behavior: "smooth"
  });

});


/* =================================
   TOMBOL MUSIK
================================= */

let musicPlaying = true;

musicButton.addEventListener("click", function () {

  if (musicPlaying) {

    musik.pause();

    musicButton.innerHTML = "🔇";

    musicPlaying = false;

  } else {

    musik.play();

    musicButton.innerHTML = "🎵";

    musicPlaying = true;

  }

});


/* =================================
   COUNTDOWN
================================= */

const targetDate =
  new Date(
    "2026-10-22T08:00:00+07:00"
  ).getTime();


function updateCountdown() {

  const now =
    new Date().getTime();

  const distance =
    targetDate - now;


  if (distance <= 0) {

    document.getElementById("days").innerText = "0";

    document.getElementById("hours").innerText = "0";

    document.getElementById("minutes").innerText = "0";

    document.getElementById("seconds").innerText = "0";

    return;

  }


  const days =
    Math.floor(
      distance /
      (1000 * 60 * 60 * 24)
    );


  const hours =
    Math.floor(
      (distance %
      (1000 * 60 * 60 * 24)) /
      (1000 * 60 * 60)
    );


  const minutes =
    Math.floor(
      (distance %
      (1000 * 60 * 60)) /
      (1000 * 60)
    );


  const seconds =
    Math.floor(
      (distance %
      (1000 * 60)) /
      1000
    );


  document.getElementById("days")
    .innerText = days;

  document.getElementById("hours")
    .innerText = hours;

  document.getElementById("minutes")
    .innerText = minutes;

  document.getElementById("seconds")
    .innerText = seconds;

}


updateCountdown();

setInterval(
  updateCountdown,
  1000
);


/* =================================
   ANIMASI SAAT SCROLL
================================= */

const reveals =
  document.querySelectorAll(".reveal");


function revealOnScroll() {

  const windowHeight =
    window.innerHeight;


  reveals.forEach(function(element) {

    const elementTop =
      element.getBoundingClientRect().top;


    if (
      elementTop <
      windowHeight - 100
    ) {

      element.classList.add("active");

    }

  });

}


window.addEventListener(
  "scroll",
  revealOnScroll
);


revealOnScroll();
@import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600;700&family=Playfair+Display:wght@400;600;700&display=swap');

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  font-family: "Cormorant Garamond", serif;
  background: #f7f3e8;
  color: #214331;
  line-height: 1.8;
}

.hidden {
  display: none;
}


/* =========================
   COVER
========================= */

.cover {
  min-height: 100vh;

  display: flex;
  justify-content: center;
  align-items: center;

  text-align: center;

  padding: 30px;

  color: white;

  position: relative;
  overflow: hidden;

  background:
    radial-gradient(
      circle at 50% 30%,
      #286447 0%,
      #173f2a 45%,
      #0c281a 100%
    );
}


/* BULAN */

.moon {
  font-size: 70px;
  color: #e4bd45;

  animation:
    moonFloat 4s ease-in-out infinite;
}


@keyframes moonFloat {

  0%,100% {
    transform: translateY(0);
  }

  50% {
    transform: translateY(-12px);
  }

}


/* BINTANG */

.stars,
.stars::before,
.stars::after {

  content: "";

  position: absolute;

  width: 3px;
  height: 3px;

  background: #f4d875;

  border-radius: 50%;

  box-shadow:
    40px 80px #f4d875,
    100px 180px #f4d875,
    180px 70px #f4d875,
    250px 150px #f4d875,
    330px 90px #f4d875,
    420px 200px #f4d875,
    520px 100px #f4d875,
    620px 180px #f4d875,
    720px 70px #f4d875,
    800px 220px #f4d875,
    900px 120px #f4d875,
    1000px 250px #f4d875;

  opacity: .5;

  animation: twinkle 3s infinite alternate;
}


@keyframes twinkle {

  from {
    opacity: .2;
  }

  to {
    opacity: .9;
  }

}


.cover-content {

  position: relative;
  z-index: 5;

  max-width: 650px;

  animation: coverIn 1.5s ease;
}


@keyframes coverIn {

  from {
    opacity: 0;
    transform: translateY(40px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }

}


.subtitle {

  letter-spacing: 5px;
  font-size: 15px;
}


.cover h1 {

  font-family: "Playfair Display", serif;

  font-size: clamp(42px, 9vw, 72px);

  line-height: 1.15;

  margin: 20px 0;

  color: #f1cf61;

  text-shadow:
    0 4px 15px rgba(0,0,0,.4);
}


.ornament {

  color: #d5ad38;

  font-size: 20px;

  margin: 20px;
}


.open-button {

  margin-top: 30px;

  border: none;

  padding: 15px 30px;

  border-radius: 50px;

  background: #d4af37;

  color: #193c29;

  font-family: inherit;

  font-size: 17px;

  font-weight: bold;

  cursor: pointer;

  box-shadow:
    0 8px 25px rgba(0,0,0,.3);

  transition: .3s;

}


.open-button:hover {

  transform: translateY(-4px) scale(1.03);

  background: #f2d56c;

}


/* =========================
   SECTION
========================= */

.section {

  padding: 80px 20px;

}


.container {

  max-width: 850px;

  margin: auto;

  text-align: center;

}


.section h2 {

