}


.countdown {

  display: grid;

  grid-template-columns:
    repeat(4, 1fr);

  gap: 15px;

  max-width: 650px;

  margin: 35px auto 0;

}


.count-box {

  padding: 20px 10px;

  border-radius: 15px;

  background:
    rgba(255,255,255,.08);

  border:
    1px solid rgba(225,193,84,.5);

  transition: .3s;

}


.count-box:hover {

  transform:
    translateY(-8px);

  background:
