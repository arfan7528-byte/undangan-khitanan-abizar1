}


.count-box span {

  display: block;

  font-size: 35px;

  font-weight: bold;

  color: #f0d061;

}


.count-box small {

  color: white;

}


/* =========================
   EVENT
========================= */

.event {

  background: #fffdf7;

}


.event-card {

  max-width: 650px;

  margin: auto;

  padding: 40px 25px;

  background: white;

  border-radius: 20px;

  border-top: 5px solid #d4af37;

  box-shadow:
    0 15px 40px rgba(0,0,0,.08);

  transition: .4s;

}


.event-card:hover {

  transform:
    translateY(-8px);

  box-shadow:
    0 20px 50px rgba(0,0,0,.13);

}


.event-icon {

  font-size: 50px;

  margin-bottom: 15px;

}


.event-card h3 {

  font-size: 27px;

  color: #286447;

  margin-bottom: 20px;

}


.event-detail {

  margin: 12px 0;

  font-size: 18px;

}


/* =========================
   LOCATION
========================= */

.location {

  background: #eaf1e9;

}


.address {

  font-size: 19px;

  margin-bottom: 30px;

}


.button {

  display: inline-block;

  padding: 14px 27px;

  border-radius: 50px;

  text-decoration: none;

  font-weight: bold;

  margin: 7px;

  transition: .3s;

}


.button:hover {

  transform:
    translateY(-4px);

}


.maps {

  background: #286447;

  color: white;

}


.whatsapp {

  background: #25d366;

  color: white;

}


/* =========================
   RSVP
========================= */

.rsvp {

  background: #fffdf7;

}


/* =========================
   CLOSING
========================= */

.closing {

  background: #173f2a;

  color: white;

}


.closing .arabic {

  color: #efd066;

  margin-bottom: 30px;

}


.closing h3 {

  margin-top: 35px;

  color: #efd066;

}


.closing h4 {

  font-size: 20px;

  margin-top: 15px;

  font-weight: normal;

}


/* =========================
   MUSIC BUTTON
========================= */

.music-button {

  position: fixed;

  z-index: 999;

  right: 20px;

  bottom: 20px;

  width: 50px;

  height: 50px;

  border: 2px solid #d4af37;

  border-radius: 50%;

  background: #173f2a;

  color: white;

  font-size: 20px;

  cursor: pointer;

  box-shadow:
    0 5px 20px rgba(0,0,0,.25);

  animation:
    musicSpin 3s linear infinite;

}


@keyframes musicSpin {

  from {
    transform: rotate(0deg);
  }

  to {
    transform: rotate(360deg);
  }

}


/* =========================
   SCROLL ANIMATION
========================= */

.reveal {

  opacity: 0;

  transform:
    translateY(50px);

  transition:
    opacity 1s ease,
    transform 1s ease;

}


.reveal.active {

  opacity: 1;

  transform:
    translateY(0);

}


/* =========================
   FOOTER
========================= */

footer {

  text-align: center;

  padding: 20px;

  background: #0e2c1d;

  color: #bbb;

  font-size: 14px;

}


/* =========================
   MOBILE
========================= */

@media (max-width: 600px) {

  .section {

    padding: 60px 18px;

  }


  .countdown {

    grid-template-columns:
      repeat(2, 1fr);

  }


  .count-box span {

    font-size: 28px;

  }


  .arabic {

    font-size: 23px;

  }


  .cover h1 {

    font-size: 45px;

  }

}
